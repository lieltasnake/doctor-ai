{
  "expo": {
    "name": "Doctor AI",
    "slug": "doctor-ai",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.mahletalemu.doctorai",
      "icon": "./assets/icon.png"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Doctor AI to use the microphone to listen to your symptoms."
      }
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d4768f4d-0645-4d93-be10-6d9188ee4387"
      }
    },
    "owner": "mahlet-alemu"
  }
}
